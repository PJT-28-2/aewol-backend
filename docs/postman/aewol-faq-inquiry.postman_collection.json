{
  "info": {
    "name": "애월 - FAQ·1:1문의 테스트 (2026-08-08)",
    "description": "0.로그인 -> 1.FAQ 목록 -> 2.FAQ 상세 -> 3.문의 등록 -> 4.문의 목록 -> 5.문의 상세 순서로 실행. accessToken/faqId/inquiryId는 이전 요청 응답에서 자동으로 컬렉션 변수에 저장됨. FAQ 목록이 비어있으면 V16__seed_faq.sql 마이그레이션이 적용됐는지 먼저 확인할 것.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "loginEmail", "value": "테스트 계정 이메일 입력" },
    { "key": "loginPassword", "value": "테스트 계정 비밀번호 입력" },
    { "key": "faqId", "value": "" },
    { "key": "inquiryId", "value": "" },
    { "key": "inquiryCategory", "value": "계좌연동", "description": "지갑·버킷 / 보험 / 계좌연동 / 공동양육 / 회원정보 / 기타 중 하나" }
  ],
  "item": [
    {
      "name": "0. 로그인 (토큰 발급)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "const d = body.data || body.result || body;",
              "if (d.accessToken) pm.collectionVariables.set('token', d.accessToken);",
              "pm.test('200 OK, accessToken 존재', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(d.accessToken).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
        }
      },
      "description": "회원가입된 테스트 계정으로 로그인해서 JWT 발급 -> token 변수에 자동 저장됨."
    },
    {
      "name": "1. FAQ 목록 조회",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "const d = body.data || body.result || body;",
              "if (Array.isArray(d) && d.length > 0 && d[0].faqId) pm.collectionVariables.set('faqId', d[0].faqId);",
              "pm.test('200 OK, 배열 응답', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(d).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/support/faqs?category=&keyword=",
          "host": ["{{baseUrl}}"],
          "path": ["api", "support", "faqs"],
          "query": [
            { "key": "category", "value": "", "description": "지갑·버킷 / 보험 / 계좌연동 / 공동양육 / 회원정보 / 기타" },
            { "key": "keyword", "value": "" }
          ]
        }
      },
      "description": "category/keyword 둘 다 비워두면 전체 목록 조회. 첫 번째 결과의 faqId를 다음 요청용으로 자동 저장."
    },
    {
      "name": "2. FAQ 상세 조회",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "const d = body.data || body.result || body;",
              "pm.test('200 OK, answer 존재', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(d.answer).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/support/faqs/{{faqId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "support", "faqs", "{{faqId}}"]
        }
      },
      "description": "1번 요청에서 자동 저장된 faqId 사용. 존재하지 않는 faqId면 404."
    },
    {
      "name": "3. 1:1 문의 등록 (첨부파일 없음)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "const d = body.data || body.result || body;",
              "if (d.inquiryId) pm.collectionVariables.set('inquiryId', d.inquiryId);",
              "pm.test('201 Created, inquiryNumber 존재', function () {",
              "    pm.response.to.have.status(201);",
              "    pm.expect(d.inquiryNumber).to.match(/^AEW-\\d{8}-\\d{4}$/);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": { "raw": "{{baseUrl}}/api/support/inquiries", "host": ["{{baseUrl}}"], "path": ["api", "support", "inquiries"] },
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "category", "value": "{{inquiryCategory}}", "type": "text" },
            { "key": "title", "value": "계좌 연동이 안돼요", "type": "text" },
            { "key": "content", "value": "1원 인증까지 완료했는데 계좌 등록이 안 돼요.", "type": "text" },
            { "key": "replyEmail", "value": "tester@example.com", "type": "text" }
          ]
        }
      },
      "description": "첨부파일 없이 등록하는 기본 케이스. 첨부파일 테스트는 아래 3-1 요청에서 attachments 필드에 로컬 파일을 직접 선택해서 실행."
    },
    {
      "name": "3-1. 1:1 문의 등록 (첨부파일 포함, 파일은 직접 선택)",
      "request": {
        "method": "POST",
        "url": { "raw": "{{baseUrl}}/api/support/inquiries", "host": ["{{baseUrl}}"], "path": ["api", "support", "inquiries"] },
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "category", "value": "보험", "type": "text" },
            { "key": "title", "value": "보험금 청구 서류 문의", "type": "text" },
            { "key": "content", "value": "영수증 첨부했는데 OCR 인식이 잘 안 돼요.", "type": "text" },
            { "key": "replyEmail", "value": "tester@example.com", "type": "text" },
            { "key": "attachments", "type": "file", "src": [], "description": "Postman에서 '파일 선택'으로 JPG/PNG/PDF, 각 10MB 이하, 최대 3개까지 직접 첨부" }
          ]
        }
      },
      "description": "attachments의 src는 컬렉션 파일에 경로를 저장할 수 없어 비워둠 - Postman UI에서 Body 탭 열고 직접 파일을 선택해야 함."
    },
    {
      "name": "4. 내 문의 목록 조회",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/support/inquiries?status=&page=0&size=10",
          "host": ["{{baseUrl}}"],
          "path": ["api", "support", "inquiries"],
          "query": [
            { "key": "status", "value": "", "description": "WAITING 또는 ANSWERED, 비워두면 전체" },
            { "key": "page", "value": "0" },
            { "key": "size", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "5. 문의 상세 조회",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "const d = body.data || body.result || body;",
              "pm.test('200 OK, inquiryNumber 존재', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(d.inquiryNumber).to.be.a('string');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/support/inquiries/{{inquiryId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "support", "inquiries", "{{inquiryId}}"]
        }
      },
      "description": "3번 요청에서 자동 저장된 inquiryId 사용. 다른 회원 소유이거나 존재하지 않으면 404."
    }
  ]
}
