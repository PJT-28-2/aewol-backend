# 운영 배포용 환경변수. 이 파일을 .env.prod로 복사해 값을 채운다.
#
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d
#
# .env.prod는 절대 커밋하지 않는다(.gitignore에 등록되어 있다).
# 실제 운영에서는 이 파일 대신 SSM Parameter Store에서 값을 받아 생성하는 것을 권장한다.

# ── 이미지 (CD가 커밋 SHA로 채운다) ────────────────────────────────
APP_IMAGE=<ECR>/aewol-backend:<commit-sha>
OCR_IMAGE=<ECR>/aewol-ocr:<commit-sha>

# ── DB ────────────────────────────────────────────────────────────
# 컨테이너끼리는 compose 네트워크에서 서비스명으로 통신한다.
# 로컬(localhost:3307)과 달리 호스트명이 mysql, 포트가 3306인 점에 주의.
DB_URL=jdbc:mysql://mysql:3306/aewol?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
DB_NAME=aewol
DB_USERNAME=
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ── 내부 서비스 ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
OCR_SERVICE_URL=http://ocr-service:8000
FILE_UPLOAD_DIR=/app/uploads

# ── S3 (업로드 파일 저장소) ────────────────────────────────────────
S3_BUCKET=
S3_REGION=ap-northeast-2
# 멍스타그램 공개 사진 CDN. 비어 있으면 공개 사본을 만들지 않고 서명 URL로 보여 준다.
# CloudFront 등에서 버킷의 public/ prefix만 서빙하는 주소를 넣으면 만료 없는 URL이 나간다.
# 예: https://cdn.aewol.store
S3_PUBLIC_BASE_URL=
S3_PUBLIC_PREFIX=public

# DB 백업을 올릴 버킷(scripts/backup-db.sh). 업로드 파일 버킷과 같아도 되지만
# 수명주기 규칙을 따로 걸 수 있어 분리하는 편이 낫다.
BACKUP_BUCKET=

# ── 필수 시크릿 (미설정 시 기동 실패) ──────────────────────────────
JWT_SECRET=
ACCOUNT_ENCRYPTION_KEY=
ACCOUNT_HASH_KEY=

# ── 도메인 (운영 도메인으로 반드시 교체) ───────────────────────────
# 쉼표로 여러 개를 넣을 수 있다.
CORS_ALLOWED_ORIGINS=https://example.com
# 카카오 개발자 콘솔에도 동일한 값을 등록해야 한다.
KAKAO_REDIRECT_URI=https://example.com/callback/kakao

# ── 메일 ──────────────────────────────────────────────────────────
MAIL_USERNAME=
MAIL_PASSWORD=

# ── 외부 API ──────────────────────────────────────────────────────
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
CODEF_CLIENT_ID=
CODEF_CLIENT_SECRET=
# 기본값은 데모 서버(https://development.codef.io) — 실제 1원 이체가 일어나지 않는다.
# 정식 계약 후 https://api.codef.io 로 교체한다.
CODEF_API_BASE_URL=https://development.codef.io
APMS_SERVICE_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOV24_SERVICE_KEY=
ANIMAL_HOSPITAL_SERVICE_KEY=

# ── 선택 ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
INSIGHT_ENABLED=true

# 시연용. true로 켜면 1원 인증 입금자명이 verify-deposit 응답에 실려 나가서,
# 실제 입금 확인 없이도 인증을 통과시킬 수 있다. 시연 서버에서만 켠다.
# CODEF_API_BASE_URL이 정식 서버(api.codef.io)면 이 값이 true여도 무시된다.
DEMO_EXPOSE_DEPOSITOR_NAME=false
