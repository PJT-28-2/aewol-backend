{
  "uid": "aewol-overview",
  "title": "애월 운영 지표",
  "tags": [
    "aewol"
  ],
  "timezone": "Asia/Seoul",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "custom",
        "query": "prod,local",
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "options": [
          {
            "text": "prod",
            "value": "prod",
            "selected": true
          },
          {
            "text": "local",
            "value": "local",
            "selected": false
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "커넥션 대기",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_pending{application=\"aewol-backend\",environment=~\"$environment\"})"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "description": "0보다 크면 풀이 부족하거나 커넥션을 오래 쥐고 있다 (#338)"
    },
    {
      "id": 2,
      "type": "stat",
      "title": "사용 중 커넥션",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_active{application=\"aewol-backend\",environment=~\"$environment\"})"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "max": 10,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 8
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        }
      },
      "description": "최대 10개"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "배치 대기",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(executor_queued_tasks{application=\"aewol-backend\",environment=~\"$environment\",name=\"batch\"})"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        }
      },
      "description": "0보다 크면 스케줄러 풀이 부족하다 (#348)"
    },
    {
      "id": 4,
      "type": "stat",
      "title": "힙 사용량",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{application=\"aewol-backend\",environment=~\"$environment\",area=\"heap\"})"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP 요청/초",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{application=\"aewol-backend\",environment=~\"$environment\"}[5m]))",
          "legendFormat": "전체"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP p95 지연",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"aewol-backend\",environment=~\"$environment\"}[5m])))",
          "legendFormat": "p95"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "DB 커넥션 풀",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_active{application=\"aewol-backend\",environment=~\"$environment\"})",
          "legendFormat": "사용 중"
        },
        {
          "refId": "B",
          "expr": "sum(hikaricp_connections_idle{application=\"aewol-backend\",environment=~\"$environment\"})",
          "legendFormat": "대기"
        },
        {
          "refId": "C",
          "expr": "sum(hikaricp_connections_pending{application=\"aewol-backend\",environment=~\"$environment\"})",
          "legendFormat": "획득 대기"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "스케줄러 풀",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(executor_active_threads{application=\"aewol-backend\",environment=~\"$environment\",name=\"batch\"})",
          "legendFormat": "실행 중"
        },
        {
          "refId": "B",
          "expr": "sum(executor_queued_tasks{application=\"aewol-backend\",environment=~\"$environment\",name=\"batch\"})",
          "legendFormat": "대기"
        },
        {
          "refId": "C",
          "expr": "sum(executor_pool_size_threads{application=\"aewol-backend\",environment=~\"$environment\",name=\"batch\"})",
          "legendFormat": "풀 크기"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "JVM 힙",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{application=\"aewol-backend\",environment=~\"$environment\",area=\"heap\"})",
          "legendFormat": "사용"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{application=\"aewol-backend\",environment=~\"$environment\",area=\"heap\"})",
          "legendFormat": "최대"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "프로세스 CPU",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{application=\"aewol-backend\",environment=~\"$environment\"}",
          "legendFormat": "CPU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "API별 요청 수 (5분)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(15, sum by (method, uri, status) (increase(http_server_requests_seconds_count{application=\"aewol-backend\",environment=~\"$environment\"}[5m])))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true
            }
          }
        }
      ]
    }
  ]
}
