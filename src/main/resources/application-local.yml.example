# =====================================================================
# application-local.yml 예시 — 이 파일을 복사해서 application-local.yml로 만든다.
#   cp src/main/resources/application-local.yml.example src/main/resources/application-local.yml
# application-local.yml은 .gitignore에 등록되어 있어 커밋되지 않는다.
# 실제 비밀값은 절대 이 예시 파일에 쓰지 않는다.
#
# docker-compose 로컬 컨테이너 기준 기본값:
#   MySQL: localhost:3307 / aewol / aewol1234
#   Redis: localhost:6379
# =====================================================================

spring:
  datasource:
    url: jdbc:mysql://localhost:3307/aewol?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
    username: aewol
    password: ${DB_PASSWORD}
    driver-class-name: com.mysql.cj.jdbc.Driver

  data:
    redis:
      host: localhost
      port: 6379

  mail:
    host: smtp.gmail.com
    port: 587
    username: ${MAIL_USERNAME}
    password: ${MAIL_PASSWORD}
    properties:
      mail:
        smtp:
          auth: true
          starttls:
            enable: true

  batch:
    jdbc:
      initialize-schema: always
    job:
      enabled: false

jwt:
  secret: ${JWT_SECRET}   # 256비트(32자) 이상
  access-token-expiry: 1800000
  refresh-token-expiry: 604800000

# 계좌번호 등 민감정보 암호화(AccountNumberCrypto, 2026-08-13 추가).
# 아래 명령으로 각각 생성해서 셸 환경변수로 export 해두면 된다. 암호화 키는 정확히
# 32바이트, 해시 키는 32바이트 이상(base64 인코딩 전 기준)이어야 하고, 절대 커밋하지 않는다.
#   openssl rand -base64 32
security:
  account:
    encryption-key: ${ACCOUNT_ENCRYPTION_KEY}
    hash-key: ${ACCOUNT_HASH_KEY}

# Toss 없이 MAIN 지갑을 올리는 로컬 데모 API(#298). 운영에서는 켜지 않는다.
wallet:
  allow-unverified-deposit: true

external:
  solapi:
    api-key: ${SOLAPI_API_KEY}
    api-secret: ${SOLAPI_API_SECRET}
    sender: ${SOLAPI_SENDER}
  kakao:
    client-id: ${KAKAO_CLIENT_ID}
    client-secret: ${KAKAO_CLIENT_SECRET}
    redirect-uri: http://localhost:5173/callback/kakao
  ocr-service:
    url: http://localhost:8000
  toss:
    client-key: ${TOSS_CLIENT_KEY}
    secret-key: ${TOSS_SECRET_KEY}
  gemini:
    api-key: ${GEMINI_API_KEY}
  codef:
    client-id: ${CODEF_CLIENT_ID}
    client-secret: ${CODEF_CLIENT_SECRET}
    oauth-url: ${CODEF_OAUTH_URL:https://oauth.codef.io/oauth/token}
    api-base-url: ${CODEF_API_BASE_URL:https://development.codef.io}
  apms:
    service-key: ${APMS_SERVICE_KEY}
    base-url: ${APMS_BASE_URL:https://apis.data.go.kr/1543061/animalInfoSrvc_v3/animalInfo_v3}
  naver:
    client-id: ${NAVER_CLIENT_ID}
    client-secret: ${NAVER_CLIENT_SECRET}
  gov24:
    service-key: ${GOV24_SERVICE_KEY}
  apms:
    service-key: ${APMS_SERVICE_KEY:}
  animal-hospital:
    service-key: ${ANIMAL_HOSPITAL_SERVICE_KEY}


file:
  upload-dir: ./uploads

logging:
  level:
    com.aewol: DEBUG
