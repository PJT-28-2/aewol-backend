<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aewol.domain.grouppurchase.mapper.GroupPurchaseMapper">
    <!-- V1: 작성자 컴럼은 member_id, 참여 테이블은 group_purchase_participant(purchase_quantity) -->

    <!-- status 필터는 저장 코드가 아니라 GroupPurchaseServiceImpl#computeStatus와 동일한
         계산 규칙(마감 시각, 목표 수량 달성 여부)으로 판정한다. 필터는 반드시 LIMIT 이전에 적용한다.
         OPEN/COMPLETED/FAILED는 다른 3개 조회 API(getDetail/getStatus/getMyList)와 동일한 값이다 —
         마감(취소)된 게시글은 이 목록에서 아예 노출하지 않으므로(status != 'CANCELLED') CANCELLED 분기는 없다.
         target_quantity <= 0인 행(정상 생성 경로로는 나올 수 없는 레거시/비정상 데이터)은 목록 자체에서
         제외한다 — 마감 자동 환불 배치(findExpiredUnfulfilledPaidParticipants)는 이 목록과 무관하게
         계속 처리하므로 결제된 참여자 환불에는 영향이 없다. -->
    <!--
        목록은 카드에 그릴 값만 있으면 된다. description은 TEXT라 SELECT *로 가져오면
        페이지 크기만큼 본문 전체가 딸려온다. 상세(findById)에서만 읽으면 충분하다.
        delivery_* 는 목록 응답(GroupPurchaseListItemResponse)에 없다. image는 목록 카드
        썸네일에 필요해 포함한다 — 저장값은 키이고 화면에 보일 서명 URL은 조회 시점에
        FileStorage#signedUrl로 만든다(GroupPurchaseServiceImpl#toListItemResponse).
        is_urgent_active는 응답 DTO에 노출하지 않는다 — 정렬/커서 전용 내부 컬럼이다(V49).
    -->
    <!-- 키워드는 LIKE '%...%' 대신 FULLTEXT(ngram) MATCH...AGAINST로 찾는다(V48). 한 글자
         검색어는 ngram_token_size(기본값 2) 미만이라 색인되지 않으므로 매칭되지 않는다 —
         GroupPurchaseServiceImpl에서 최소 2자 이상만 여기로 넘어오게 걸러낸다. 서비스가
         boolean mode 예약문자를 큰따옴표 구문(phrase) 검색으로 감싸 전달하므로 이 쿼리는
         키워드를 가공하지 않고 그대로 쓴다. -->
    <select id="findList" resultType="map">
        SELECT gp_id,
               member_id,
               product_name,
               category,
               image,
               unit_price,
               group_price,
               target_quantity,
               current_quantity,
               status,
               is_urgent_active,
               deadline,
               created_at
        FROM group_purchase
        <where>
            status != 'CANCELLED' AND target_quantity &gt; 0
            <choose>
                <when test="status == 'OPEN'">
                    AND current_quantity &lt; target_quantity AND deadline &gt;= NOW()
                </when>
                <when test="status == 'COMPLETED'">
                    AND current_quantity &gt;= target_quantity
                </when>
                <when test="status == 'FAILED'">
                    AND current_quantity &lt; target_quantity AND deadline &lt; NOW()
                </when>
            </choose>
            <if test="category != null and category != ''">
                AND category = #{category}
            </if>
            <if test="keyword != null and keyword != ''">
                AND MATCH(product_name) AGAINST(#{keyword} IN BOOLEAN MODE)
            </if>
            <!-- 커서(keyset) 페이지네이션. 정렬 기준과 정확히 같은 컬럼 순서로 "그 행보다 뒤에 오는
                 행"만 남긴다. OFFSET과 달리 앞선 행을 읽고 버리지 않아 페이지가 깊어져도 비용이
                 늘지 않는다. 첫 페이지(cursorGpId == null)는 조건 없이 처음부터 조회한다.

                 legacyOffset은 배포 전환 기간 호환 전용이다(GroupPurchaseServiceImpl 참고) —
                 cursor 없이 구 프론트의 page만 오는 요청을 위한 것으로, cursor와 동시에
                 채워지지 않는다(서비스 레이어가 상호 배타적으로 보장). 새 정렬 기준(is_urgent_active
                 포함)을 그대로 쓰므로 예전 CASE WHEN NOW() 버그는 재도입되지 않는다.

                 주의: cursorGpId != null 하나로만 이 블록 전체를 게이팅하고, 안에서는
                 cursorIsUrgentActive/cursorDeadline/cursorCreatedAt도 무조건 같이 참조한다.
                 네 필드는 항상 함께 null이거나 함께 값이 있어야 한다(GroupPurchaseMapper.java
                 참고) — 일부만 채워서 호출하면 예외 없이 조용히 빈 결과가 나온다(NULL 비교는
                 항상 false). -->
            <if test="cursorGpId != null">
                <choose>
                    <when test="status == null or status == ''">
                        AND (
                            is_urgent_active &lt; #{cursorIsUrgentActive}
                            OR (is_urgent_active = #{cursorIsUrgentActive} AND deadline &gt; #{cursorDeadline})
                            OR (is_urgent_active = #{cursorIsUrgentActive} AND deadline = #{cursorDeadline} AND created_at &lt; #{cursorCreatedAt})
                            OR (is_urgent_active = #{cursorIsUrgentActive} AND deadline = #{cursorDeadline} AND created_at = #{cursorCreatedAt} AND gp_id &lt; #{cursorGpId})
                        )
                    </when>
                    <otherwise>
                        AND (
                            deadline &gt; #{cursorDeadline}
                            OR (deadline = #{cursorDeadline} AND created_at &lt; #{cursorCreatedAt})
                            OR (deadline = #{cursorDeadline} AND created_at = #{cursorCreatedAt} AND gp_id &lt; #{cursorGpId})
                        )
                    </otherwise>
                </choose>
            </if>
        </where>
        <!-- 진행중(마감 전이고 목표 미달)인 게시글을 먼저, 마감된(목표 달성/미달) 게시글을 뒤로 묶고,
             각 그룹 안에서는 마감이 임박한(deadline 오름차순) 순으로, 마감이 같으면 최신 등록순으로 보여준다.

             상태 필터가 걸린 경우에는 is_urgent_active가 항상 같은 값이다. WHERE가 이미 한쪽으로
             좁혀놓기 때문이다(OPEN이면 1, COMPLETED·FAILED면 0). 그래서 정렬에서 빼도
             결과 순서가 같고, 대신 (deadline, created_at DESC, gp_id DESC) 인덱스가 정렬을 그대로 제공할 수 있다.

             필터가 없는 전체 탭은 두 그룹이 섞여 있어 is_urgent_active가 필요하다. 예전에는
             CASE WHEN ... NOW() ...로 매 요청 계산해서 어떤 인덱스도 순서를 줄 수 없었지만(V39/V42에
             "별도 과제"로 명시), 이제는 미리 계산해 저장해둔 is_urgent_active 컬럼을 읽기만 하므로
             idx_gp_urgent_deadline_created(V49)가 정렬을 그대로 제공한다. -->
        ORDER BY
            <if test="status == null or status == ''">
            is_urgent_active DESC,
            </if>
            deadline ASC, created_at DESC, gp_id DESC
        <choose>
            <when test="legacyOffset != null">
                LIMIT #{limit} OFFSET #{legacyOffset}
            </when>
            <otherwise>
                LIMIT #{limit}
            </otherwise>
        </choose>
    </select>

    <select id="findById" resultType="map">
        SELECT * FROM group_purchase WHERE gp_id = #{gpId}
    </select>

    <!-- delivery_date는 등록 시 deadline + delivery_estimate_days(잠정치)로 채워지고, 목표 수량 달성
         시점에 updateDeliveryDate로 confirmedDate + delivery_estimate_days로 갱신된다(V22).
         is_urgent_active는 등록 직후 항상 1이다 — GroupPurchaseCreateRequest가 deadline을 @Future로
         검증하고(생성 시점엔 반드시 미래) current_quantity는 0이라 current < target이 항상 참이다. -->
    <insert id="insert" parameterType="map" useGeneratedKeys="true" keyProperty="gpId" keyColumn="gp_id">
        INSERT INTO group_purchase
            (member_id, product_name, category, image, unit_price, group_price,
             delivery_method, delivery_fee, delivery_date, delivery_estimate_days, description, target_quantity, deadline, is_urgent_active)
        VALUES
            (#{memberId}, #{productName}, #{category}, #{image}, #{unitPrice}, #{groupPrice},
             #{deliveryMethod}, #{deliveryFee}, #{deliveryDate}, #{deliveryEstimateDays}, #{description}, #{targetQuantity}, #{deadline}, 1)
    </insert>

    <!-- 목표 수량 초과·마감 여부·취소 여부를 조건절에 포함한 조건부 원자 UPDATE로 수량을 예약한다.
         current_quantity/target_quantity/deadline/status를 애플리케이션에서 미리 읽어 비교하면
         동시 요청 사이에 값이 바뀌어 목표 수량을 초과하거나 취소된 공동구매에 참여할 수 있으므로,
         반드시 이 WHERE 절 안에서 판정해야 한다.
         영향받은 행이 0이면(조건 불충족) 호출부에서 참여를 거절해야 한다.
         이 UPDATE로 목표 수량에 도달하면(current_quantity + quantity = target_quantity) 같은 문장 안에서
         is_urgent_active를 0으로 함께 내린다 — 배치를 기다리지 않고 그 즉시 전체 탭 정렬에 반영된다.

         SET 절의 순서가 중요하다(리뷰로 발견한 실제 버그): MySQL은 같은 UPDATE 문 안의 SET 절을
         왼쪽에서 오른쪽으로 순차 평가하고, 뒤에 오는 절은 앞에서 이미 갱신된 값을 본다. is_urgent_active
         CASE를 current_quantity 갱신 뒤에 두면 그 안의 current_quantity가 "이미 quantity만큼 더해진"
         값을 가리켜, 거기에 quantity를 한 번 더 더한 것과 같아진다(사실상 목표 도달 여부를 실제
         증가분의 두 배 기준으로 판정). 예: current=7, target=10, quantity=2로 참여하면 실제
         새 current_quantity=9(아직 미달, urgent 유지돼야 함)인데, 잘못된 순서에서는
         9+2=11 >= target(10)로 오판해 is_urgent_active를 0으로 내려버린다 — 이후 leave()도
         자정 배치도 이 값을 되돌리지 않아 V50 주석이 경계한 "영구히 잘못 박힌 채 남는" 상태가 된다.
         반드시 is_urgent_active를 먼저 계산해(이 시점엔 current_quantity가 아직 원본 값이라
         + #{quantity}가 순수하게 "이번에 참여할 양"만 의미한다) current_quantity 갱신보다 앞에 둔다.
         H2(GroupPurchaseMapperTest)는 이 순차 평가 방식을 따르지 않아(모든 SET 절이 갱신 전 스냅숏을
         봄) 이 버그를 재현하지 못한다 — 그래서 실 MySQL 통합 테스트로 별도 검증한다
         (GroupPurchaseUpdateQuantitySetOrderIntegrationTest). -->
    <update id="updateQuantity">
        UPDATE group_purchase
        SET is_urgent_active = CASE WHEN current_quantity + #{quantity} &lt; target_quantity THEN 1 ELSE 0 END,
            current_quantity = current_quantity + #{quantity}
        WHERE gp_id = #{gpId}
          AND current_quantity + #{quantity} &lt;= target_quantity
          AND deadline &gt;= NOW()
          AND status != 'CANCELLED'
    </update>

    <!-- 목표 수량을 처음 달성하는 순간(join()에서 감지) delivery_date를 confirmedDate + delivery_estimate_days로
         갱신한다. updateQuantity의 WHERE 절이 이미 "목표 도달은 그 공동구매의 마지막 성공 join() 호출 단
         한 번뿐"임을 보장하므로, 같은 트랜잭션 안에서 별도 가드 없이 호출해도 정확히 한 번만 반영된다. -->
    <update id="updateDeliveryDate">
        UPDATE group_purchase
        SET delivery_date = #{deliveryDate}
        WHERE gp_id = #{gpId}
    </update>

    <!-- join의 updateQuantity와 대칭. 목표 수량 달성(confirmed) 이후나 마감 후에는 참여 취소를 허용하지 않으므로
         (목표 달성 후에는 관리자 문의로만 취소 가능), 그 판정도 동시성 문제 없이 이 WHERE 절 안에서 수행한다.
         영향받은 행이 0이면 호출부에서 취소를 거절해야 한다. -->
    <update id="decreaseQuantity">
        UPDATE group_purchase
        SET current_quantity = current_quantity - #{quantity}
        WHERE gp_id = #{gpId}
          AND current_quantity - #{quantity} &gt;= 0
          AND current_quantity &lt; target_quantity
          AND deadline &gt;= NOW()
          AND status != 'CANCELLED'
    </update>

    <!-- leave()의 decreaseQuantity와 대칭이지만 deadline &lt; NOW()로 뒤집혀 있다 — 마감 후 자동 환불
         배치(Notion 순서19) 전용이라, 아직 마감 전인 공동구매는 절대 건드리면 안 된다. -->
    <update id="decreaseQuantityForExpired">
        UPDATE group_purchase
        SET current_quantity = current_quantity - #{quantity}
        WHERE gp_id = #{gpId}
          AND current_quantity - #{quantity} &gt;= 0
          AND current_quantity &lt; target_quantity
          AND deadline &lt; NOW()
          AND status != 'CANCELLED'
    </update>

    <insert id="insertParticipant" parameterType="map" useGeneratedKeys="true" keyProperty="participantId" keyColumn="participant_id">
        INSERT INTO group_purchase_participant
            (gp_id, member_id, purchase_quantity, recipient_name, recipient_phone, zip_code, address, address_detail,
             paid_amount, payment_status, paid_at, txn_id)
        VALUES
            (#{gpId}, #{memberId}, #{quantity}, #{recipientName}, #{recipientPhone}, #{zipCode}, #{address}, #{addressDetail},
             #{paidAmount}, #{paymentStatus}, #{paidAt}, #{txnId})
    </insert>

    <!-- CANCELLED 참여는 취소 이력일 뿐 현재 참여 상태가 아니므로 isParticipating 판정·중복 참여 체크·
         상태 화면 조회에서 항상 제외한다(V18: active_member_id 생성 컬럼과 같은 기준). -->
    <select id="findParticipant" resultType="map">
        SELECT * FROM group_purchase_participant
        WHERE gp_id = #{gpId} AND member_id = #{memberId} AND payment_status != 'CANCELLED'
    </select>

    <!-- 목록 카드의 isParticipating만 필요하므로 참여 row 전체가 아니라 gp_id만 가져온다.
         항목마다 findParticipant를 치면 페이지 크기만큼 N+1이 되므로, 현재 페이지 gp_id만 IN으로 한 번에 조회한다.
         CANCELLED는 findParticipant와 같이 현재 참여가 아니다. gpIds가 비면 호출하지 않는다. -->
    <select id="findParticipatingGpIds" resultType="long">
        SELECT gp_id
        FROM group_purchase_participant
        WHERE member_id = #{memberId}
          AND payment_status != 'CANCELLED'
          AND gp_id IN
          <foreach collection="gpIds" item="gpId" open="(" separator="," close=")">
              #{gpId}
          </foreach>
    </select>

    <!-- 참여 취소는 row를 삭제하지 않고 CANCELLED로 남겨 취소 이력을 보존한다(V18: active_member_id
         생성 컬럼 + 부분 유니크 인덱스가 취소 후 재참여를 허용한다). 동시 중복 취소 요청은 영향받은
         행이 0인 것으로 감지해 거절한다(이미 CANCELLED인 행은 WHERE 조건에서 걸러짐). -->
    <update id="cancelParticipant">
        UPDATE group_purchase_participant
        SET payment_status = 'CANCELLED', canceled_at = #{canceledAt}
        WHERE gp_id = #{gpId} AND member_id = #{memberId} AND payment_status != 'CANCELLED'
    </update>

    <!-- 게시글은 관리자만 작성하므로, 마이페이지는 참여글(group_purchase_participant)만 조회한다.
         작성글 조회는 별도의 관리자 전용 엔드포인트에서 처리한다(이 쿼리 범위 밖).
         status 필터는 저장 코드가 아니라 GroupPurchaseServiceImpl#computeStatus와 동일한 계산 규칙(4분리:
         OPEN/COMPLETED/FAILED/CANCELLED)으로 판정한다. -->
    <select id="findMyGroupPurchases" resultType="map">
        SELECT gp.* FROM group_purchase gp
        JOIN group_purchase_participant gpp ON gpp.gp_id = gp.gp_id
        WHERE gpp.member_id = #{memberId}
        AND gpp.payment_status != 'CANCELLED'
        <if test="status == 'OPEN'">
            AND gp.status != 'CANCELLED' AND (gp.target_quantity &lt;= 0 OR gp.current_quantity &lt; gp.target_quantity) AND gp.deadline &gt;= NOW()
        </if>
        <if test="status == 'COMPLETED'">
            AND gp.status != 'CANCELLED' AND gp.target_quantity &gt; 0 AND gp.current_quantity &gt;= gp.target_quantity
        </if>
        <if test="status == 'FAILED'">
            AND gp.status != 'CANCELLED' AND (gp.target_quantity &lt;= 0 OR gp.current_quantity &lt; gp.target_quantity) AND gp.deadline &lt; NOW()
        </if>
        <if test="status == 'CANCELLED'">
            AND gp.status = 'CANCELLED'
        </if>
        <!-- findList와 동일한 기준: 마감이 임박한(deadline 오름차순) 순으로, 마감이 같으면 최신 등록순.

             findList와 달리 idx_gp_deadline_created의 혜택을 못 받는다 — 이 쿼리는 join의 드라이빙
             테이블이 gp가 아니라 gpp(member_id로 먼저 좁힘)라, 정렬 컬럼이 있는 gp 쪽 인덱스로는
             조인 결과에 순서를 줄 수 없다(EXPLAIN 확인: Using temporary; Using filesort, 상태 필터
             유무 무관). 다만 이 필터링 결과는 이미 회원 한 명의 참여 건수로 좁혀진 소량이라
             filesort 비용이 findList의 전체 목록 정렬과는 비교가 안 되게 작다 — 20만 행 중 특정
             회원 참여 5,000건으로 측정해도 체감 지연은 없었다. 별도 인덱스로 해결하려면 join
             순서 자체를 gp 우선으로 강제해야 하는데, 그러려면 gp 쪽에서 먼저 필터링할 조건이
             없어 실익이 없다. -->
        ORDER BY gp.deadline ASC, gp.created_at DESC, gp.gp_id DESC
    </select>

    <!-- 마감이 지났고 목표 수량 미달인 공동구매의 PAID 참여자를 조회한다(마감 자동 환불 배치 전용, Notion 순서19).
         이미 처리된 참여자는 cancelParticipant로 CANCELLED가 되어 이 조건에서 자연히 빠지므로,
         배치를 몇 번 재실행해도 같은 참여자를 중복 환불하지 않는다(자연 멱등). -->
    <select id="findExpiredUnfulfilledPaidParticipants" resultType="map">
        SELECT gpp.* FROM group_purchase_participant gpp
        JOIN group_purchase gp ON gp.gp_id = gpp.gp_id
        WHERE gpp.payment_status = 'PAID'
          AND gp.status != 'CANCELLED'
          AND gp.deadline &lt; NOW()
          AND (gp.target_quantity &lt;= 0 OR gp.current_quantity &lt; gp.target_quantity)
    </select>

    <!-- 작성자(관리자) 전체 취소(순서18). join()의 updateQuantity와 동일한 원자적 조건부 UPDATE 패턴 —
         이미 취소됐거나(status='CANCELLED'), 목표 수량을 채웠거나(현재수량 >= 목표수량), 마감이 지난
         공동구매는 취소할 수 없다. 영향받은 행이 0이면 호출부에서 취소를 거절해야 한다.
         target_quantity &lt;= 0(정상 생성 경로로는 나올 수 없는 레거시/비정상 데이터)인 행은 findList와
         달리 여기서는 제외하지 않는다 — findExpiredUnfulfilledPaidParticipants/findMyGroupPurchases와
         동일하게 "목표 미달" 취급해 관리자가 계속 취소할 수 있게 한다(그렇지 않으면 이 행은 자동 환불
         배치의 deadline 통과 전까지 영구히 취소 불가 상태로 남는다). -->
    <update id="cancelGroupPurchase">
        UPDATE group_purchase
        SET status = 'CANCELLED', is_urgent_active = 0
        WHERE gp_id = #{gpId}
          AND status != 'CANCELLED'
          AND (target_quantity &lt;= 0 OR current_quantity &lt; target_quantity)
          AND deadline &gt;= NOW()
    </update>

    <!-- 작성자 전체 취소 대상 참여자를 조회한다(순서18 전용). CANCELLED는 이미 처리된 이력이라 제외하지만,
         PENDING도 함께 돌려준다 — 결제 전 참여라도 게시글이 취소되면 참여 이력 자체를 CANCELLED로
         남겨야 하기 때문이다(leave()가 PAID/PENDING을 가리지 않고 항상 cancelParticipant를 호출하는
         것과 동일한 원칙). 환불은 호출부에서 payment_status='PAID'인 경우에만 수행한다.
         FOR UPDATE로 current read를 강제한다 — MySQL 기본 격리수준(REPEATABLE READ)에서 일반 SELECT는
         이 트랜잭션의 첫 읽기(findById) 시점 스냅샷을 그대로 재사용하므로, cancelGroupPurchase(UPDATE는
         항상 current read라 안전)가 실행된 뒤 그 사이 다른 트랜잭션에서 커밋된 join() 참여가 이 SELECT엔
         보이지 않을 수 있다 — 게시글은 CANCELLED로 바뀌는데 그 참여자만 환불 대상에서 누락되는 문제.
         FOR UPDATE는 최신 커밋 데이터를 읽고, 대상 행을 잠가 트랜잭션 종료까지 다른 트랜잭션이 값을
         바꾸지 못하게도 막는다(AccountMapper.findByAccountIdForUpdate와 동일한 패턴). -->
    <select id="findActiveParticipants" resultType="map">
        SELECT * FROM group_purchase_participant
        WHERE gp_id = #{gpId} AND payment_status != 'CANCELLED'
        FOR UPDATE
    </select>

    <!-- GroupPurchaseUrgentFlagJob 전용(V49). 마감 시각 경과는 그 행에 대한 쓰기 이벤트가 아니라
         DB 트리거로 감지할 수 없으므로, 매일 자정 직후 배치가 is_urgent_active=1인데 이미
         deadline이 지난 행만 골라 0으로 내린다. idx_gp_urgent_deadline_created의 선두 컬럼이
         is_urgent_active라 이 UPDATE 자체도 "1인 행"만 골라내는 인덱스 스캔이라 저비용이다. -->
    <update id="deactivateExpiredUrgentFlags">
        UPDATE group_purchase
        SET is_urgent_active = 0
        WHERE is_urgent_active = 1
          AND deadline &lt; NOW()
    </update>

</mapper>
